# =====================================================================
# Text-to-SQL Agent configuration. Copy to .env and fill in.
# =====================================================================

# ---------------------------------------------------------------- PostgreSQL
# Used by docker-compose to create the database (admin user = owner of the data).
POSTGRES_DB=shopdb
POSTGRES_USER=shop_admin
POSTGRES_PASSWORD=change-me-admin-password
POSTGRES_PORT=5432

# The app connects with this READ-ONLY role (created by db/init/03_roles.sh).
READONLY_USER=text2sql_reader
READONLY_PASSWORD=change-me-readonly-password

# Connection used by the app. Either set DATABASE_URL directly ...
# DATABASE_URL=postgresql+psycopg://text2sql_reader:change-me-readonly-password@localhost:5432/shopdb
# ... or the parts below (password special characters are escaped for you).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=shopdb
DB_READONLY_USER=text2sql_reader
DB_READONLY_PASSWORD=change-me-readonly-password
DB_SCHEMA=public

# Optional allow-list (comma-separated, bare or schema-qualified). Empty = every
# table the read-only role can SELECT in DB_SCHEMA.
ALLOWED_TABLES=
# Refuse to start if the role can write / is superuser. Keep true in production.
REQUIRE_READ_ONLY_ROLE=true

# ---------------------------------------------------------------- query safety
QUERY_TIMEOUT_SECONDS=15
MAX_ROWS=1000
MAX_RETRIES=2

# ---------------------------------------------------------------- LLM
# openai | anthropic | openai_compatible | ollama
LLM_PROVIDER=openai
# Any chat model your provider offers, e.g. gpt-4.1-mini (OpenAI), claude-sonnet-5-5 (Anthropic),
# llama3.1 / qwen2.5-coder (Ollama).
LLM_MODEL=gpt-4.1-mini
# API key (falls back to OPENAI_API_KEY / ANTHROPIC_API_KEY)
LLM_API_KEY=
# Only for openai_compatible / ollama (or a proxy):
#   Ollama on the host from Docker: http://host.docker.internal:11434/v1
#   Ollama compose service:         http://ollama:11434/v1
LLM_BASE_URL=
LLM_TEMPERATURE=0
LLM_MAX_OUTPUT_TOKENS=2048
LLM_TIMEOUT_SECONDS=60
# Token budget for retrieved schema/docs in the prompt
CONTEXT_TOKEN_BUDGET=12000

# ---------------------------------------------------------------- RAG
# default = local all-MiniLM-L6-v2 (no API key; baked into the Docker image)
# openai  = OpenAI embeddings (uses EMBEDDING_API_KEY or OPENAI_API_KEY)
# hashing = offline lexical embeddings (air-gapped / tests)
EMBEDDING_PROVIDER=default
EMBEDDING_MODEL=text-embedding-3-small
VECTOR_DB_PATH=./data/chroma
KNOWLEDGE_DIR=./knowledge
RAG_N_RESULTS=8
# Record distinct values of low-cardinality text columns (e.g. order status). PII-like columns are skipped.
SAMPLE_COLUMN_VALUES=true
# Train the knowledge base automatically on first start
AUTO_TRAIN=true

# ---------------------------------------------------------------- results
# LLM summary of results (sends up to SUMMARY_MAX_ROWS rows to the LLM)
SUMMARY_ENABLED=true
SUMMARY_MAX_ROWS=50
# Previous turns kept as conversational context for follow-ups
HISTORY_TURNS=5
